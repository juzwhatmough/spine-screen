# Copy this file to .env.local for local development.
# In Vercel, add these same variables under Project Settings > Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only — never exposed to the browser.
ANTHROPIC_API_KEY=your-anthropic-api-key
JUZ_EMAIL=the-email-you-sign-in-with@example.com
# Optional. Adds movies to the title type-ahead in the "Add a show" modal.
# Without it, series-only search via TVMaze (free, no key) is used. Free at
# themoviedb.org/settings/api — use the "API Key" (v3 auth, a plain
# string), NOT the "API Read Access Token" (v4 auth, a JWT).
TMDB_API_KEY=your-tmdb-api-key
# Optional: gives the Add-a-book title search its own Google Books quota (server-side; falls back to Open Library without it).
GOOGLE_BOOKS_API_KEY=
