# Copy this file to .env.local for local development.
# In Vercel, add these same variables under Project Settings > Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only — never exposed to the browser.
ANTHROPIC_API_KEY=your-anthropic-api-key
JUZ_EMAIL=the-email-you-sign-in-with@example.com
# Powers the title type-ahead in the "Add a show" modal only (Google
# Books' equivalent for "Add a book" needs no key). Free at
# themoviedb.org/settings/api — use the "API Key" (v3 auth, a plain
# string), NOT the "API Read Access Token" (v4 auth, a JWT meant for an
# Authorization header) — this project's code only sends it as the v3
# ?api_key= query param.
TMDB_API_KEY=your-tmdb-api-key
